{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "kata-local",
      "runtimeExecutable": "docker",
      "runtimeArgs": [
        "compose",
        "-f",
        "docker-compose.local.yml",
        "up",
        "--build"
      ],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "kata-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev"
      ],
      "port": 3000,
      "autoPort": false
    }
  ]
}
