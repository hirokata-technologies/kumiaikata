{
	"name": "kata-monorepo",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@10.11.1",
	"engines": {
		"node": ">=24",
		"pnpm": ">=10"
	},
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"dev:web": "pnpm --filter @kata/web dev",
		"build": "pnpm --filter @kata/web build",
		"preview": "pnpm --filter @kata/web preview",
		"start": "pnpm --filter @kata/web start",
		"check": "pnpm --filter @kata/web check",
		"check:watch": "pnpm --filter @kata/web check:watch",
		"check:api": "pnpm --filter @kata/api check",
		"build:mcp": "pnpm --filter @kata/mcp build",
		"start:mcp": "pnpm --filter @kata/mcp start",
		"check:mcp": "pnpm --filter @kata/mcp check",
		"lint": "pnpm --filter @kata/web lint && pnpm --filter @kata/api lint",
		"lint:web": "pnpm --filter @kata/web lint",
		"lint:api": "pnpm --filter @kata/api lint",
		"test": "pnpm --filter @kata/api test && pnpm --filter @kata/web test",
		"test:api": "pnpm --filter @kata/api test",
		"test:web": "pnpm --filter @kata/web test",
		"test:packages": "pnpm --filter @kata/http test && pnpm --filter @kata/db test",
		"test:integration": "pnpm --filter @kata/integration-tests test",
		"db:up": "node scripts/dev-db.mjs up",
		"db:down": "node scripts/dev-db.mjs down",
		"db:reset": "node scripts/dev-db.mjs reset",
		"db:migrate": "pnpm --filter @kata/api migrate",
		"guild:import": "pnpm --filter @kata/api import:guild"
	},
	"devDependencies": {
		"eslint": "^10.11.0",
		"globals": "^17.12.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.1"
	}
}
