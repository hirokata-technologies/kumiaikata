# Port the app listens on. Railway sets this automatically in production.
# Must be a valid integer in the range 1–65535; invalid values cause a Node.js startup crash.
PORT=3000

# Exposed to the browser via the Better Auth client (apps/web/src/lib/auth-client.ts).
PUBLIC_API_URL=http://localhost:8787

# Server-only — read by apps/web/src/hooks.server.ts for SSR session lookup.
# Must NOT be prefixed PUBLIC_ so SvelteKit does not ship it to the client.
API_URL=http://localhost:8787

# Sentry DSN for the kata-web project. Find it at https://hirokata.sentry.io/settings/projects/kata-web/keys/
# PUBLIC_ prefix makes it available in both browser and server-side SvelteKit code.
PUBLIC_SENTRY_DSN=

# Server-only — Minimax API key used by apps/web/src/routes/api/ai/analyze/+server.ts.
# Passed to the Anthropic SDK as a Bearer token against the Minimax endpoint.
# Must NOT be prefixed PUBLIC_ so SvelteKit does not ship it to the client.
MINIMAX_API_KEY=
