# Runtime configuration for the single Kata app (SvelteKit + Hono API on one origin).
# Copy to apps/web/.env for `pnpm dev`; in production set these on the Cloud Run service.
# See the repo README ("Deploying on Google Cloud Run") for the full list and notes.

# ── adapter-node ─────────────────────────────────────────────────────────────
# Port to listen on. Cloud Run sets this automatically.
PORT=3000
# Public origin of the app (scheme + host, no path). Production: https://kumiai.hirokata.dev
# Not needed for `pnpm dev`.
ORIGIN=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────────────
# Local Postgres:
DATABASE_URL=postgresql://kata:kata@localhost:5432/kata
# Cloud SQL (unix socket, Cloud Run):
# DATABASE_URL=postgresql://kumiai:PASSWORD@localhost/kumiai?host=/cloudsql/kumiaikata:asia-southeast1:kumiai

# ── Auth (Better Auth) ───────────────────────────────────────────────────────
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Same origin as the app: Better Auth is served at <BETTER_AUTH_URL>/api/auth.
# The Google OAuth redirect URI is <BETTER_AUTH_URL>/api/auth/callback/google
BETTER_AUTH_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only the hirokata.dev domain is permitted in production; "localhost" is for local dev only.
ALLOWED_DOMAINS=hirokata.dev,localhost
# Optional: extra origins Better Auth should trust besides BETTER_AUTH_URL (comma separated).
# ALLOWED_ORIGINS=

# ── Email (sent inline through Resend; no queue) ─────────────────────────────
RESEND_API_KEY=

# ── Attachments ──────────────────────────────────────────────────────────────
# Cloud Storage bucket (uses Application Default Credentials). When unset, files are
# written to ATTACHMENTS_DIR on local disk (development only).
# GCS_BUCKET=
ATTACHMENTS_DIR=./.attachments
# Upload limit in bytes (default 25 MiB). BODY_SIZE_LIMIT (adapter-node, 32M in the
# image) must stay above it.
# MAX_ATTACHMENT_BYTES=26214400

# ── Sentry ───────────────────────────────────────────────────────────────────
# DSN for the kata-web project. PUBLIC_ prefix makes it available in browser and server.
PUBLIC_SENTRY_DSN=
