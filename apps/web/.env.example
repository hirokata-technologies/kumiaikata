# Port the app listens on. Railway sets this automatically in production.
# Must be a valid integer in the range 1–65535; invalid values cause a Node.js startup crash.
PORT=3000

# Exposed to the browser via the Better Auth client (apps/web/src/lib/auth-client.ts).
PUBLIC_API_URL=http://localhost:8787

# Server-only — read by apps/web/src/hooks.server.ts for SSR session lookup.
# Must NOT be prefixed PUBLIC_ so SvelteKit does not ship it to the client.
API_URL=http://localhost:8787
