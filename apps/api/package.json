{
	"name": "@kata/api",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "tsx --import ./src/instrument.ts watch src/index.ts",
		"build": "tsc -p tsconfig.json",
		"start": "node --import ./dist/instrument.js dist/index.js",
		"check": "tsc -p tsconfig.json --noEmit",
		"lint": "eslint src",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"test": "vitest run --passWithNoTests",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage --passWithNoTests"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1139.0",
		"@aws-sdk/lib-storage": "^3.1139.0",
		"@hono/node-server": "^2.1.1",
		"@hono/zod-validator": "^0.8.0",
		"@kata/auth": "workspace:*",
		"@kata/db": "workspace:*",
		"@kata/events": "workspace:*",
		"@kata/http": "workspace:*",
		"@kata/queues": "workspace:*",
		"@kata/redis": "workspace:*",
		"@sentry/node": "^10.75.3",
		"better-auth": "^1.7.5",
		"drizzle-orm": "^0.45.3",
		"fractional-indexing": "^3.4.0",
		"hono": "^4.13.9",
		"nanoid": "^5.1.16",
		"pg": "^8.23.0",
		"resend": "^6.28.1",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@types/node": "^24.13.6",
		"@types/pg": "^8.23.1",
		"@vitest/coverage-v8": "^4.1.11",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.11",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vitest": "^4.1.11"
	}
}
