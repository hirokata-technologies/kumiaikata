{
	"name": "@kata/api",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"check": "tsc -p tsconfig.json --noEmit",
		"lint": "eslint src",
		"migrate": "node --env-file-if-exists=../web/.env migrate.js",
		"import:guild": "node --env-file-if-exists=../web/.env scripts/import-guild.mjs",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"test": "vitest run --passWithNoTests",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage --passWithNoTests"
	},
	"dependencies": {
		"@better-auth/cimd": "1.7.10",
		"@better-auth/mcp": "1.7.10",
		"@better-auth/oauth-provider": "1.7.10",
		"@google-cloud/storage": "^7.22.0",
		"@hono/zod-validator": "^0.8.0",
		"@kata/db": "workspace:*",
		"@kata/http": "workspace:*",
		"@modelcontextprotocol/server": "2.3.1",
		"@sentry/node": "^10.76.2",
		"better-auth": "^1.7.12",
		"drizzle-orm": "^0.45.4",
		"fractional-indexing": "^3.4.0",
		"google-auth-library": "^9.15.1",
		"hono": "^4.13.13",
		"nanoid": "^5.1.16",
		"pg": "^8.23.1",
		"resend": "^6.34.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/node": "^24.19.2",
		"@types/pg": "^8.23.1",
		"@vitest/coverage-v8": "^4.1.12",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.11",
		"typescript": "^6.0.3",
		"vitest": "^4.1.12"
	},
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"main": "./src/index.ts"
}
