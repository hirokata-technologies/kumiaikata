{
	"name": "@kata/relay-service",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "tsx --import ./src/instrument.ts watch src/index.ts",
		"build": "tsc -p tsconfig.json",
		"start": "node --import ./dist/instrument.js dist/index.js",
		"check": "tsc -p tsconfig.json --noEmit",
		"lint": "eslint src"
	},
	"dependencies": {
		"@hono/node-server": "^2.1.1",
		"@kata/auth": "workspace:*",
		"@kata/db": "workspace:*",
		"@kata/events": "workspace:*",
		"@kata/http": "workspace:*",
		"@kata/queues": "workspace:*",
		"@kata/redis": "workspace:*",
		"@sentry/node": "^10.75.3",
		"hono": "^4.13.9",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@types/node": "^24.13.6",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3"
	}
}
