{
	"name": "@kata/relay-service",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": { "node": ">=24" },
	"scripts": {
		"dev": "tsx --import ./src/instrument.ts watch src/index.ts",
		"build": "tsc -p tsconfig.json",
		"start": "node --import ./dist/instrument.js dist/index.js",
		"check": "tsc -p tsconfig.json --noEmit",
		"lint": "eslint src"
	},
	"dependencies": {
		"@kata/auth": "workspace:*",
		"@kata/db": "workspace:*",
		"@kata/events": "workspace:*",
		"@kata/http": "workspace:*",
		"@kata/queues": "workspace:*",
		"@kata/redis": "workspace:*",
		"@hono/node-server": "^2.0.4",
		"@sentry/node": "^10.55.0",
		"hono": "^4.12.23",
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@types/node": "^24.12.4",
		"tsx": "^4.22.3",
		"typescript": "^6.0.3"
	}
}
